--============================================================
-- Reset Teleport Adapter
-- For your own Roblox game / clone or a hub that exposes a
-- public/shared travel request.
--
-- USER CONFIG (kept intentionally small):
-- _G.OneClickSettings = {
--     ["Reset Teleport"] = true,
--     ["Reset Teleport Delay"] = 2.5
-- }
--
-- PUBLIC INPUTS SUPPORTED BY THE ADAPTER:
-- 1) _G.KaitunTargetIsland = "Jungle"
-- 2) _G.TargetIsland        = "Jungle"
-- 3) ReplicatedStorage.KaitunTravelRequest (BindableEvent)
--    Fire("Jungle")
--
-- PUBLIC OUTPUT:
-- _G.ResetTeleportResult = {
--     Success = true/false,
--     Reason = "Complete" / ...,
--     TargetIsland = "Jungle"
-- }
--
-- IMPORTANT:
-- A closed third-party hub that exposes NONE of these signals cannot be
-- reliably integrated by this adapter. It must expose a public handoff/API.
--============================================================

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

_G.OneClickSettings = _G.OneClickSettings or {}
local UserSettings = _G.OneClickSettings

if UserSettings["Reset Teleport"] == nil then
    UserSettings["Reset Teleport"] = true
end

if UserSettings["Reset Teleport Delay"] == nil then
    UserSettings["Reset Teleport Delay"] = 2.5
end

--============================================================
-- INTERNAL DEFAULTS
--============================================================

local DEFAULTS = {
    TravelDistance = 1500,
    WaypointDistance = 300,
    WaypointTimeout = 10,
    StuckTimeout = 4,
    ArrivalRadius = 100,
    IslandSearchRadius = 120,
    FinalApproachDistance = 450,
    RespawnTimeout = 15,
    PostRespawnDelay = 0.5,
    NormalMoveTimeout = 12,
    PollInterval = 0.25,
    MaxRecoveries = 3,
    PositionEpsilon = 3,
    StuckSampleInterval = 0.5,
    EventName = "KaitunTravelRequest",
}

local SPECIAL_ITEMS = {
    ["God's Chalice"] = true,
    ["Sweet Chalice"] = true,
    ["Hallow Essence"] = true,
    ["Fist of Darkness"] = true,
    ["Water Key"] = true,
    ["Hidden Key"] = true,
    ["Library Key"] = true,
    ["Red Key"] = true,
}

--============================================================
-- CONTROLLER
--============================================================

local Controller = {
    Busy = false,
    Status = "Idle",
    TargetIsland = nil,
    TargetPosition = nil,
    LastReason = nil,
    Cancelled = false,
    RequestToken = 0,
    RecoveryCount = 0,
    LastObservedTarget = nil,
}

--============================================================
-- HELPERS
--============================================================

local function safeString(v)
    if v == nil then
        return nil
    end
    return tostring(v)
end

local function getCharacter()
    return LocalPlayer and LocalPlayer.Character or nil
end

local function getHumanoid()
    local character = getCharacter()
    if not character then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local character = getCharacter()
    if not character then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function isAlive()
    local humanoid = getHumanoid()
    local root = getRoot()
    return humanoid ~= nil and humanoid.Health > 0 and root ~= nil
end

local function getObjectPosition(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object.Position
    end

    if object:IsA("Model") then
        return object:GetPivot().Position
    end

    if object:IsA("Attachment") then
        return object.WorldPosition
    end

    return nil
end

local function findNamedChildIgnoreCase(parent, name)
    if not parent or not name then
        return nil
    end

    local exact = parent:FindFirstChild(name)
    if exact then
        return exact
    end

    local wanted = string.lower(name)
    for _, child in ipairs(parent:GetChildren()) do
        if string.lower(child.Name) == wanted then
            return child
        end
    end

    return nil
end

local function findIsland(name)
    if type(name) ~= "string" or name == "" then
        return nil
    end

    local islands = workspace:FindFirstChild("Islands")
    if not islands then
        return nil
    end

    return findNamedChildIgnoreCase(islands, name)
end

local function getArrivalPoint(island)
    if not island then
        return nil
    end

    -- Prefer an explicitly authored safe/travel point in the clone.
    local preferred = {
        "TravelPoint",
        "SafePoint",
        "ArrivalPoint",
        "Spawn",
        "Center",
    }

    for _, name in ipairs(preferred) do
        local point = findNamedChildIgnoreCase(island, name)
        local position = getObjectPosition(point)
        if position then
            return position
        end
    end

    -- Fall back to model/part position.
    return getObjectPosition(island)
end

local function getIslandBounds(island)
    if not island then
        return nil, nil
    end

    if island:IsA("Model") then
        local ok, cf, size = pcall(function()
            local cframe, dimensions = island:GetBoundingBox()
            return cframe, dimensions
        end)

        if ok and cf and size then
            return cf, size
        end
    elseif island:IsA("BasePart") then
        return island.CFrame, island.Size
    end

    return nil, nil
end

local function clampInside(value, halfExtent, padding)
    local limit = math.max(0, halfExtent - padding)
    return math.clamp(value, -limit, limit)
end

local function getSafePointInsideIsland(island, preferredPoint)
    local boxCFrame, size = getIslandBounds(island)
    if not boxCFrame or not size then
        return preferredPoint
    end

    local localPoint = boxCFrame:PointToObjectSpace(preferredPoint)
    local padding = math.min(8, math.min(size.X, size.Y, size.Z) * 0.1)

    -- Keep the point away from the outermost boundary where possible.
    local clamped = Vector3.new(
        clampInside(localPoint.X, size.X / 2, padding),
        clampInside(localPoint.Y, size.Y / 2, padding),
        clampInside(localPoint.Z, size.Z / 2, padding)
    )

    return boxCFrame:PointToWorldSpace(clamped)
end

local function getTargetPoint(island)
    local arrival = getArrivalPoint(island)
    if not arrival then
        return nil
    end
    return getSafePointInsideIsland(island, arrival)
end

--============================================================
-- HELD ITEM / FRUIT GUARD
--============================================================

local function getHeldTool()
    local character = getCharacter()
    if not character then
        return nil
    end

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            return child
        end
    end

    return nil
end

local function isFruit(tool)
    if not tool then
        return false
    end

    if tool:GetAttribute("IsFruit") == true then
        return true
    end

    if tool:GetAttribute("ItemType") == "Fruit" then
        return true
    end

    if tool:GetAttribute("Type") == "Fruit" then
        return true
    end

    local name = string.lower(tool.Name)
    return string.find(name, "fruit", 1, true) ~= nil
end

local function getResetBlockReason()
    local tool = getHeldTool()
    if not tool then
        return nil
    end

    if isFruit(tool) then
        return "HoldingFruit:" .. tool.Name
    end

    if SPECIAL_ITEMS[tool.Name] then
        return "HoldingSpecialItem:" .. tool.Name
    end

    return nil
end

--============================================================
-- ROUTE
--============================================================

local function buildWaypoints(startPosition, targetPosition)
    local points = {}
    local difference = targetPosition - startPosition
    local distance = difference.Magnitude

    if distance <= 0 then
        return points
    end

    local count = math.max(1, math.ceil(distance / DEFAULTS.WaypointDistance))
    for index = 1, count do
        points[index] = startPosition:Lerp(targetPosition, index / count)
    end

    return points
end

local function isCloseTo(positionA, positionB, radius)
    return (positionA - positionB).Magnitude <= radius
end

--============================================================
-- CANCELLATION TOKEN
--============================================================

local function tokenIsCurrent(token)
    return token == Controller.RequestToken and not Controller.Cancelled
end

--============================================================
-- SOFT MOVEMENT FOR CLONE
--============================================================

local function moveByInterpolation(targetPosition, timeout, token)
    local root = getRoot()
    if not root then
        return false, "NoRoot"
    end

    local startCFrame = root.CFrame
    local targetCFrame = CFrame.new(targetPosition)
    local distance = (root.Position - targetPosition).Magnitude

    if distance <= DEFAULTS.PositionEpsilon then
        return true, "AlreadyThere"
    end

    local travelTime = math.clamp(distance / 120, 0.8, 4.0)
    local startTime = os.clock()
    local lastPosition = root.Position
    local lastProgressTime = startTime

    while true do
        if not tokenIsCurrent(token) then
            return false, "Cancelled"
        end

        if not isAlive() then
            return false, "CharacterLost"
        end

        local elapsed = os.clock() - startTime
        if elapsed >= timeout then
            return false, "Timeout"
        end

        local alpha = math.clamp(elapsed / travelTime, 0, 1)
        root.CFrame = startCFrame:Lerp(targetCFrame, alpha)

        local currentPosition = root.Position
        if (currentPosition - lastPosition).Magnitude >= DEFAULTS.PositionEpsilon then
            lastPosition = currentPosition
            lastProgressTime = os.clock()
        elseif os.clock() - lastProgressTime >= DEFAULTS.StuckTimeout then
            return false, "Stuck"
        end

        if alpha >= 1 then
            return true, "Arrived"
        end

        RunService.Heartbeat:Wait()
    end
end

--============================================================
-- NORMAL TRAVEL (<= 1500)
--============================================================

local function normalTravel(targetPosition, token)
    local humanoid = getHumanoid()
    local root = getRoot()
    if not humanoid or not root then
        return false, "NoCharacter"
    end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 8,
    })

    local ok = pcall(function()
        path:ComputeAsync(root.Position, targetPosition)
    end)

    if ok and path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        for _, waypoint in ipairs(waypoints) do
            if not tokenIsCurrent(token) then
                return false, "Cancelled"
            end

            if not isAlive() then
                return false, "CharacterLost"
            end

            if waypoint.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end

            humanoid:MoveTo(waypoint.Position)

            local started = os.clock()
            local lastPosition = root.Position

            while os.clock() - started < DEFAULTS.NormalMoveTimeout do
                if not tokenIsCurrent(token) then
                    return false, "Cancelled"
                end

                if not isAlive() then
                    return false, "CharacterLost"
                end

                if isCloseTo(root.Position, waypoint.Position, 6) then
                    break
                end

                local current = root.Position
                if (current - lastPosition).Magnitude < DEFAULTS.PositionEpsilon then
                    -- Keep waiting, but don't let a totally stuck MoveTo block forever.
                    if os.clock() - started >= DEFAULTS.StuckTimeout then
                        return false, "Stuck"
                    end
                else
                    lastPosition = current
                end

                RunService.Heartbeat:Wait()
            end

            if not isCloseTo(root.Position, waypoint.Position, 6) then
                return false, "WaypointTimeout"
            end
        end

        return true, "PathComplete"
    end

    -- Fallback movement for a clone if pathfinding cannot build a route.
    humanoid:MoveTo(targetPosition)
    local started = os.clock()
    while os.clock() - started < DEFAULTS.NormalMoveTimeout do
        if not tokenIsCurrent(token) then
            return false, "Cancelled"
        end
        if not isAlive() then
            return false, "CharacterLost"
        end
        if isCloseTo(root.Position, targetPosition, DEFAULTS.ArrivalRadius) then
            return true, "FallbackComplete"
        end
        RunService.Heartbeat:Wait()
    end

    return false, "NormalTravelTimeout"
end

--============================================================
-- RESET / RESPAWN
--============================================================

local function resetCharacter(token)
    if not tokenIsCurrent(token) then
        return false, "Cancelled"
    end

    local guard = getResetBlockReason()
    if guard then
        return false, guard
    end

    local character = getCharacter()
    local humanoid = getHumanoid()
    if not character or not humanoid then
        return false, "NoCharacter"
    end

    -- This is intended for a clone that uses normal Humanoid respawning.
    humanoid.Health = 0

    local started = os.clock()
    while os.clock() - started < DEFAULTS.RespawnTimeout do
        if not tokenIsCurrent(token) then
            return false, "Cancelled"
        end

        local newCharacter = getCharacter()
        local newHumanoid = getHumanoid()
        local newRoot = getRoot()

        if newCharacter and newCharacter ~= character and newHumanoid and newRoot and newHumanoid.Health > 0 then
            task.wait(DEFAULTS.PostRespawnDelay)
            return true, "Respawned"
        end

        RunService.Heartbeat:Wait()
    end

    return false, "RespawnTimeout"
end

--============================================================
-- ARRIVAL CHECK
--============================================================

local function verifyArrival(island, targetPosition)
    local root = getRoot()
    if not root then
        return false
    end

    if isCloseTo(root.Position, targetPosition, DEFAULTS.ArrivalRadius) then
        return true
    end

    local boxCFrame, size = getIslandBounds(island)
    if boxCFrame and size then
        local localPosition = boxCFrame:PointToObjectSpace(root.Position)
        local half = size / 2
        return math.abs(localPosition.X) <= half.X
            and math.abs(localPosition.Y) <= half.Y + DEFAULTS.ArrivalRadius
            and math.abs(localPosition.Z) <= half.Z
    end

    return false
end

--============================================================
-- RESULT
--============================================================

local function publishResult(success, reason, targetIsland)
    local result = {
        Success = success == true,
        Reason = reason,
        TargetIsland = targetIsland,
    }

    _G.ResetTeleportResult = result
    Controller.LastReason = reason

    return result
end

--============================================================
-- REQUEST PIPELINE
--============================================================

local function runRequest(islandName, token)
    Controller.Busy = true
    Controller.Status = "Busy"
    Controller.TargetIsland = islandName
    Controller.TargetPosition = nil
    Controller.RecoveryCount = 0

    if type(islandName) ~= "string" or islandName == "" then
        Controller.Busy = false
        Controller.Status = "Failed"
        return publishResult(false, "InvalidTarget", islandName)
    end

    local island = findIsland(islandName)
    if not island then
        Controller.Busy = false
        Controller.Status = "Failed"
        return publishResult(false, "IslandNotFound", islandName)
    end

    local targetPosition = getTargetPoint(island)
    if not targetPosition then
        Controller.Busy = false
        Controller.Status = "Failed"
        return publishResult(false, "NoTargetPoint", islandName)
    end

    Controller.TargetPosition = targetPosition

    while tokenIsCurrent(token) do
        if not isAlive() then
            Controller.RecoveryCount += 1
            if Controller.RecoveryCount > DEFAULTS.MaxRecoveries then
                Controller.Busy = false
                Controller.Status = "Failed"
                return publishResult(false, "TooManyRecoveries", islandName)
            end
            task.wait(0.25)
        else
            break
        end
    end

    if not tokenIsCurrent(token) then
        Controller.Busy = false
        Controller.Status = "Failed"
        return publishResult(false, "Cancelled", islandName)
    end

    local root = getRoot()
    if not root then
        Controller.Busy = false
        Controller.Status = "Failed"
        return publishResult(false, "NoRoot", islandName)
    end

    local distance = (root.Position - targetPosition).Magnitude

    --========================================================
    -- <= 1500 studs: normal travel, never reset.
    --========================================================
    if distance <= DEFAULTS.TravelDistance then
        local success, reason = normalTravel(targetPosition, token)
        if success and verifyArrival(island, targetPosition) then
            Controller.Busy = false
            Controller.Status = "Complete"
            return publishResult(true, "NormalTravelComplete", islandName)
        end

        Controller.Busy = false
        Controller.Status = "Failed"
        return publishResult(false, reason or "NormalTravelFailed", islandName)
    end

    --========================================================
    -- > 1500 studs: Reset Teleport branch.
    --========================================================
    if UserSettings["Reset Teleport"] ~= true then
        Controller.Busy = false
        Controller.Status = "Failed"
        return publishResult(false, "ResetDisabled", islandName)
    end

    local guard = getResetBlockReason()
    if guard then
        Controller.Busy = false
        Controller.Status = "Blocked"
        return publishResult(false, guard, islandName)
    end

    local delayTime = tonumber(UserSettings["Reset Teleport Delay"]) or 2.5
    delayTime = math.max(0, delayTime)

    local delayStarted = os.clock()
    while os.clock() - delayStarted < delayTime do
        if not tokenIsCurrent(token) then
            Controller.Busy = false
            Controller.Status = "Failed"
            return publishResult(false, "Cancelled", islandName)
        end
        RunService.Heartbeat:Wait()
    end

    -- Double-check immediately before reset.
    guard = getResetBlockReason()
    if guard then
        Controller.Busy = false
        Controller.Status = "Blocked"
        return publishResult(false, guard, islandName)
    end

    local resetSuccess, resetReason = resetCharacter(token)
    if not resetSuccess then
        Controller.Busy = false
        Controller.Status = "Failed"
        return publishResult(false, resetReason, islandName)
    end

    -- The island may have changed while we reset, so resolve it again.
    island = findIsland(islandName)
    if not island then
        Controller.Busy = false
        Controller.Status = "Failed"
        return publishResult(false, "IslandGoneAfterReset", islandName)
    end

    targetPosition = getTargetPoint(island)
    if not targetPosition then
        Controller.Busy = false
        Controller.Status = "Failed"
        return publishResult(false, "NoTargetPointAfterReset", islandName)
    end

    Controller.TargetPosition = targetPosition

    root = getRoot()
    if not root then
        Controller.Busy = false
        Controller.Status = "Failed"
        return publishResult(false, "NoRootAfterReset", islandName)
    end

    local waypoints = buildWaypoints(root.Position, targetPosition)
    local waypointIndex = 1

    while waypointIndex <= #waypoints do
        if not tokenIsCurrent(token) then
            Controller.Busy = false
            Controller.Status = "Failed"
            return publishResult(false, "Cancelled", islandName)
        end

        local point = waypoints[waypointIndex]
        local success, reason = moveByInterpolation(point, DEFAULTS.WaypointTimeout, token)

        if success then
            waypointIndex += 1
        else
            Controller.RecoveryCount += 1
            if Controller.RecoveryCount > DEFAULTS.MaxRecoveries then
                Controller.Busy = false
                Controller.Status = "Failed"
                return publishResult(false, reason or "WaypointFailed", islandName)
            end

            -- Re-resolve the island and rebuild the route from the current position.
            island = findIsland(islandName)
            targetPosition = island and getTargetPoint(island) or nil
            root = getRoot()

            if not island or not targetPosition or not root then
                Controller.Busy = false
                Controller.Status = "Failed"
                return publishResult(false, "RecoveryTargetUnavailable", islandName)
            end

            Controller.TargetPosition = targetPosition
            waypoints = buildWaypoints(root.Position, targetPosition)
            waypointIndex = 1
            task.wait(0.2)
        end
    end

    island = findIsland(islandName)
    targetPosition = island and getTargetPoint(island) or targetPosition

    if island and targetPosition and verifyArrival(island, targetPosition) then
        Controller.Busy = false
        Controller.Status = "Complete"
        return publishResult(true, "ResetTeleportComplete", islandName)
    end

    -- Final approach retry inside the island's arrival area.
    root = getRoot()
    if root and targetPosition then
        local finalDistance = (root.Position - targetPosition).Magnitude
        if finalDistance <= DEFAULTS.FinalApproachDistance then
            local success = moveByInterpolation(targetPosition, DEFAULTS.WaypointTimeout, token)
            if success and island and verifyArrival(island, targetPosition) then
                Controller.Busy = false
                Controller.Status = "Complete"
                return publishResult(true, "FinalApproachComplete", islandName)
            end
        end
    end

    Controller.Busy = false
    Controller.Status = "Failed"
    return publishResult(false, "ArrivalCheckFailed", islandName)
end

function Controller:Request(islandName)
    if self.Busy then
        return false, "Busy"
    end

    self.RequestToken += 1
    self.Cancelled = false
    local token = self.RequestToken

    task.spawn(function()
        runRequest(islandName, token)
    end)

    return true, "Accepted"
end

function Controller:Cancel()
    self.Cancelled = true
    self.RequestToken += 1
    self.Busy = false
    self.Status = "Failed"
    publishResult(false, "Cancelled", self.TargetIsland)
end

function Controller:IsBusy()
    return self.Busy
end

function Controller:GetStatus()
    return self.Status
end

function Controller:GetState()
    return {
        Busy = self.Busy,
        Status = self.Status,
        TargetIsland = self.TargetIsland,
        TargetPosition = self.TargetPosition,
        LastReason = self.LastReason,
        RecoveryCount = self.RecoveryCount,
    }
end

--============================================================
-- PUBLIC HANDSHAKE / ADAPTER INPUTS
--============================================================

local function normalizeTarget(value)
    if type(value) == "string" and value ~= "" then
        return value
    end

    if type(value) == "table" then
        return value.TargetIsland or value.Island or value.Target
    end

    return nil
end

local function inspectSharedTarget()
    local candidates = {
        _G.KaitunTargetIsland,
        _G.TargetIsland,
    }

    for _, candidate in ipairs(candidates) do
        local target = normalizeTarget(candidate)
        if target then
            return target
        end
    end

    return nil
end

local eventConnection
local eventObject = ReplicatedStorage:FindFirstChild(DEFAULTS.EventName)
if eventObject and eventObject:IsA("BindableEvent") then
    eventConnection = eventObject.Event:Connect(function(payload)
        local target = normalizeTarget(payload)
        if target and target ~= Controller.LastObservedTarget then
            Controller.LastObservedTarget = target
            Controller:Request(target)
        end
    end)
end

-- Polling is deliberately limited to public shared globals only.
task.spawn(function()
    while true do
        local target = inspectSharedTarget()

        if target and target ~= Controller.LastObservedTarget then
            Controller.LastObservedTarget = target
            if not Controller.Busy then
                Controller:Request(target)
            end
        end

        task.wait(DEFAULTS.PollInterval)
    end
end)

_G.ResetTeleport = Controller
_G.ResetTeleportAdapter = Controller

if _G.ResetTeleportResult == nil then
    _G.ResetTeleportResult = {
        Success = false,
        Reason = "Idle",
        TargetIsland = nil,
    }
end

--============================================================
-- OPTIONAL SELF-CHECKS (no game mutation)
--============================================================

local function runSelfChecks()
    local checks = 0
    local passed = 0

    local function check(condition)
        checks += 1
        if condition then
            passed += 1
        end
    end

    check(DEFAULTS.TravelDistance == 1500)
    check(DEFAULTS.WaypointDistance == 300)
    check(DEFAULTS.WaypointTimeout == 10)
    check(DEFAULTS.StuckTimeout == 4)
    check(DEFAULTS.ArrivalRadius == 100)
    check(type(SPECIAL_ITEMS["God's Chalice"]) == "boolean")
    check(type(SPECIAL_ITEMS["Sweet Chalice"]) == "boolean")
    check(type(SPECIAL_ITEMS["Hallow Essence"]) == "boolean")
    check(type(Controller.Request) == "function")
    check(type(Controller.Cancel) == "function")
    check(type(Controller.GetState) == "function")

    local route = buildWaypoints(Vector3.zero, Vector3.new(900, 0, 0))
    check(#route == 3)
    check(route[#route] and route[#route].X == 900)

    local longRoute = buildWaypoints(Vector3.zero, Vector3.new(10000, 0, 0))
    check(#longRoute == 34)
    check(longRoute[#longRoute] and math.abs(longRoute[#longRoute].X - 10000) < 0.001)

    return passed, checks
end

_G.ResetTeleportSelfCheck = runSelfChecks

-- No Status spam; this only prints once at load.
local passed, total = runSelfChecks()
print(string.format("[ResetTeleportAdapter] Loaded | SelfCheck %d/%d", passed, total))
